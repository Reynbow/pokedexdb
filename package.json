{
  "name": "pokedexdb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://pokedexdb.com",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-share-pages.mjs && node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "data:snapshot": "node scripts/build-data-snapshot.mjs",
    "data:repair-flavor": "node scripts/repair-flavor-text.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "sharp": "^0.34.5",
    "vite": "^7.1.12"
  }
}
